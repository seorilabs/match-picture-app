# Dependencies
node_modules/

# Build outputs
dist/
build/
.vite/

# Apps in Toss / Granite outputs
.granite/
.ait/

# Store submission assets (not part of the app build)
store/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example
!.env.local.example
!.env.production.local.example

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local agent instructions
AGENTS.local.md

# Android signing — NEVER commit keystore or passwords
**/keystore.properties
**/key.properties
**/keystore/
*.keystore
*.jks

# TypeScript
*.tsbuildinfo

# Test and coverage outputs
coverage/

# Temporary files
tmp/
temp/

*.ait

# Godot
# .godot/ 는 import 캐시라 커밋하지 않는다. CI 는 매번 clean 에서 import 한다.
godot/.godot/
# Gradle build template 은 tools/install_android_build_template.sh 가 설치한다.
godot/android/
# CSV 에서 유도되는 import 산출물이지만 부팅 시점에 필요하다. 커밋하지 않으면
# clean 체크아웃의 첫 실행이 "Cannot open file" ERROR 를 남기고 로그 게이트가
# required check 를 red 로 만든다. lizard-tycoon 도 같은 이유로 커밋한다.
*.translation
!/godot/i18n/*.translation

# Godot export 산출물
release-artifacts/
