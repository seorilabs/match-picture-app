{
  "name": "match-picture-apps-in-toss-web",
  "private": true,
  "type": "module",
  "description": "같은그림찾기 Godot Web export를 감싸는 앱인토스 래퍼",
  "scripts": {
    "sync:godot": "node scripts/sync-godot-web.mjs",
    "dev:web": "npm run sync:godot && vite --host 0.0.0.0",
    "dev": "npm run dev:web",
    "build:web": "npm run sync:godot && tsc -b && vite build",
    "build": "npm run build:web && ait build && npm run check:brand && npm run check:no-google-api-key",
    "check:brand": "node scripts/check-ait-brand-contract.mjs",
    "check:no-google-api-key": "bash scripts/check-no-google-api-key.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^2.1.9"
  }
}
