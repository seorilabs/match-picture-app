AIT_APP_DISPLAY_NAME=같은그림찾기
AIT_BRAND_ICON_URL=<apps-in-toss-console-app-logo-image-url>
VITE_AD_GROUP_ID=<apps-in-toss-console-ad-group-id>

# Remote Config는 Firebase Remote Config로 관리합니다(파라미터: leaderboardEnabled,
# reviewRequestEnabled, interstitialAdEnabled). 아래 Firebase Web 설정은 모두 "공개
# 식별자"라 비밀이 아니며, src/firebase/config.ts에 기본값이 박혀 있어 미설정 시에도
# 동작합니다. 다른 프로젝트로 바꾸려면 override 하세요.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# 네이티브 리더보드 ID (standalone Android/iOS 전용).
# - Android: Play Console에서 게임 프로젝트 링크 후 생성한 리더보드 ID (예: CgkI...)
#   + android/app/src/main/res/values/strings.xml 의 game_services_app_id 도 실제 값으로 교체
# - iOS: App Store Connect Game Center 리더보드 ID + Game Center capability 활성화
# 미설정 시 네이티브 리더보드는 안전하게 no-op 처리됩니다(fast-follow).
# VITE_PGS_LEADERBOARD_ID=
# VITE_GAMECENTER_LEADERBOARD_ID=
